#!/bin/sh

ENABLED=yes
BOT_DIR="/opt/share/qbot"
PID_FILE="/opt/var/run/qbot.pid"
LOG_FILE="/tmp/qbot.log"

export SSL_CERT_FILE=/opt/etc/ssl/certs/ca-certificates.crt
export SSL_CERT_DIR=/opt/etc/ssl/certs
export PYTHONUNBUFFERED=1

start() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "qbot is already running (PID $(cat "$PID_FILE"))."
        return 0
    fi
    echo -n "Starting qbot... "
    mkdir -p /opt/var/run
    /opt/bin/python3 "$BOT_DIR/main.py" > "$LOG_FILE" 2>&1 < /dev/null &
    echo $! > "$PID_FILE"
    sleep 2
    if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "done (PID $(cat "$PID_FILE"))."
    else
        echo "failed! Check $LOG_FILE"
        rm -f "$PID_FILE"
        return 1
    fi
}

stop() {
    if [ ! -f "$PID_FILE" ]; then
        echo "qbot is not running."
        return 0
    fi
    PID="$(cat "$PID_FILE")"
    echo -n "Stopping qbot (PID $PID)... "
    kill "$PID" 2>/dev/null
    for _ in 1 2 3 4 5; do
        kill -0 "$PID" 2>/dev/null || break
        sleep 1
    done
    if kill -0 "$PID" 2>/dev/null; then
        kill -9 "$PID" 2>/dev/null
    fi
    rm -f "$PID_FILE"
    echo "done."
}

status() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "qbot is running (PID $(cat "$PID_FILE"))."
    else
        echo "qbot is stopped."
        return 1
    fi
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; start ;;
    status) status ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac